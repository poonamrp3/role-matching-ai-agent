# Local Gemini Web2API development configuration.
# Copy this file to .env and replace the placeholder value locally.
# .env is excluded from Git.
GEMINI_BASE_URL=http://localhost:4981/v1
GEMINI_API_KEY=sk-gemini
GEMINI_MODEL=gemini-3.5-flash

# Existing encrypted token-store connection identifier. This is not an OAuth token or secret.
GMAIL_CONNECTION_ID=demo-applications-mailbox
GMAIL_SUBMISSIONS_LABEL=CandidateSubmissions
# Absolute local path to the downloaded Google OAuth desktop-client JSON. Do not commit that file.
GMAIL_OAUTH_CLIENT_SECRETS_PATH=/absolute/path/to/client_secret.json
